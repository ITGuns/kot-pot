# Copy to .env.local and fill in.

# Postgres connection. Locally: `npm run db:local init` starts a Postgres cluster on :5433 (see scripts/local-db.mjs).
# On Supabase use the transaction pooler (port 6543) for DATABASE_URL and the session pooler (5432) for DIRECT_URL
# (aws-0-<region>.pooler.supabase.com, user postgres.<project-ref>); the direct db.*.supabase.co host is IPv6-only.
DATABASE_URL=postgresql://postgres@localhost:5433/kotpot
DIRECT_URL=postgresql://postgres@localhost:5433/kotpot

# Long random string used to sign admin session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string

# Initial admin login (created by `npm run db:seed`)
ADMIN_EMAIL=owner@kotpot.local
ADMIN_PASSWORD=change-me
ADMIN_NAME=Owner

# Public site URL, used for SEO metadata + calendar links (Vercel falls back to its production URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
